# PersonalDepth_pi — interface translation (gettext .po, UTF-8)
# msgid = English text, msgstr = translation (empty: English is shown).
# msgctxt, when present, is the exact French source text: it separates two
# texts that are the same in English but need different translations.
# Keep the %d, %s, %.2f… of the English text, in the same order.
# \n is a line break.
#
# Your corrected copy: put it in the PersonalDepth_pi user folder (the one
# that holds the palettes folder), in a "lang" subfolder, with the same
# file name. It is read after this one and is kept on plugin updates.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

#. fr: PersonalDepth — bathymétrie personnelle
msgid "PersonalDepth — personal bathymetry"
msgstr "PersonalDepth — собственная батиметрия"

#. fr: Marée
msgid "Tide"
msgstr "Прилив"

#. fr: Stations de marée OpenCPN (hauteur unique)
msgid "OpenCPN tide stations (single height)"
msgstr "Приливные станции OpenCPN (одна высота)"

#. fr: FES2022 maillé (hauteur variable sur la zone)
msgid "Gridded FES2022 (height varies over the area)"
msgstr "Сетка FES2022 (высота меняется по области)"

#. fr: FES2022 : hauteur calculée en chaque nœud de l'atlas (1/30°), ajoutée cellule par cellule ; nécessite le fichier .pdtide.
msgid "FES2022: height computed at every atlas node (1/30°) and added cell by cell; requires the .pdtide file."
msgstr "FES2022: высота вычисляется в каждом узле атласа (1/30°) и прибавляется по ячейкам; нужен файл .pdtide."

#. fr: atlas FES2022 : FES2022b_ocean.pdtide
msgid "FES2022 atlas: FES2022b_ocean.pdtide"
msgstr "Атлас FES2022: FES2022b_ocean.pdtide"

#. fr: facultatif : grille(s) Z0 = niveau moyen au-dessus du ZH (m)
msgid "optional: Z0 grid(s) = mean sea level above chart datum (m)"
msgstr "необязательно: сетка(и) Z0 = средний уровень моря над нулём глубин (м)"

#. fr: Z0 par BathyElli NM/ell − ZH/ell (dossier France) si présents
msgid "Z0 from BathyElli MSL/ell − CD/ell (France folder) if available"
msgstr "Z0 из BathyElli MSL/ell − CD/ell (папка France), если есть"

#. fr: Ordre de priorité de Z0 : grille fournie, puis BathyElli NM/ell − ZH/ell, puis plus basse mer astronomique FES sur 19 ans (approximation du ZH).
msgid "Z0 priority: supplied grid, then BathyElli MSL/ell − CD/ell, then FES lowest astronomical tide over 19 years (chart datum approximation)."
msgstr "Приоритет Z0: заданная сетка, затем BathyElli MSL/ell − CD/ell, затем наинизший теоретический уровень FES за 19 лет (приближение нуля глубин)."

#. fr: Atlas
msgid "Atlas"
msgstr "Атлас"

#. fr: Grille Z0
msgid "Z0 grid"
msgstr "Сетка Z0"

#. fr: Aucune — profondeurs au zéro hydrographique
msgid "None — depths at chart datum"
msgstr "Нет — глубины от нуля глубин"

#. fr: Hauteur d'eau actuelle (heure du PC)
msgid "Current water height (computer clock)"
msgstr "Текущая высота воды (часы компьютера)"

#. fr: Date et heure choisies
msgid "Chosen date and time"
msgstr "Выбранные дата и время"

#. fr: Faire défiler l'heure de ±12 h par pas de 15 min
msgid "Scroll the time by ±12 h in 15 min steps"
msgstr "Сдвиг времени на ±12 ч шагом 15 мин"

#. fr: Courbe de marée…
msgid "Tide curve…"
msgstr "Кривая прилива…"

#. fr: Hauteur d'eau en fonction du temps pour chaque point de marée utilisé
msgid "Water height versus time for each tide point used"
msgstr "Высота воды во времени для каждой используемой приливной точки"

#. fr: Atlas de marée FES2022
msgid "FES2022 tide atlas"
msgstr "Приливный атлас FES2022"

#. fr: Atlas PersonalDepth (*.pdtide)|*.pdtide|Tous|*
msgid "PersonalDepth atlas (*.pdtide)|*.pdtide|All|*"
msgstr "Атлас PersonalDepth (*.pdtide)|*.pdtide|Все|*"

#. fr: Grille(s) Z0 : niveau moyen au-dessus du ZH
msgid "Z0 grid(s): mean sea level above chart datum"
msgstr "Сетка(и) Z0: средний уровень моря над нулём глубин"

#. fr: Grilles (*.tac;*.mnt;*.gtx;*.asc;*.glhi;*.xyz;*.txt)|*.tac;*.mnt;*.gtx;*.asc;*.glhi;*.xyz;*.txt|Tous|*
msgid "Grids (*.tac;*.mnt;*.gtx;*.asc;*.glhi;*.xyz;*.txt)|*.tac;*.mnt;*.gtx;*.asc;*.glhi;*.xyz;*.txt|All|*"
msgstr "Сетки (*.tac;*.mnt;*.gtx;*.asc;*.glhi;*.xyz;*.txt)|*.tac;*.mnt;*.gtx;*.asc;*.glhi;*.xyz;*.txt|Все|*"

#. fr: Base de bathymétrie
msgid "Bathymetry database"
msgstr "База батиметрии"

#. fr: dossier de la base (fichiers PD_*.pdb)
msgid "database folder (PD_*.pdb files)"
msgstr "папка базы (файлы PD_*.pdb)"

#. fr: Dossier
msgid "Folder"
msgstr "Папка"

#. fr: Fichier .pdb
msgid ".pdb file"
msgstr "Файл .pdb"

#. fr: Taille
msgid "Size"
msgstr "Размер"

#. fr: Sources
msgid "Sources"
msgstr "Источники"

#. fr: Case : afficher ou masquer la bathymétrie de ce fichier (sa cellule géographique). Les sources et leur import se gèrent dans « Gestion des données ».
msgid "Checkbox: show or hide the bathymetry of this file (its geographic cell). Sources and their import are managed in “Data management”."
msgstr "Флажок: показать или скрыть батиметрию этого файла (его географической ячейки). Источники и их импорт — в «Управлении данными»."

#. fr: Gestion des données…
msgid "Data management…"
msgstr "Управление данными…"

#. fr: Importer des fichiers, voir les sources importées et leurs métadonnées, priorités, classes, nettoyage, découpage des fichiers.
msgid "Import files, view imported sources and their metadata, priorities, classes, cleaning, file splitting."
msgstr "Импорт файлов, просмотр импортированных источников и их метаданных, приоритеты, классы, очистка, разбиение файлов."

#. fr: Tout
msgid "All"
msgstr "Все"

#. fr: Aucun
msgid "None"
msgstr "Нет"

#. fr: Centrer
msgid "Centre"
msgstr "Центр"

#. fr: Centrer la carte sur les fichiers sélectionnés
msgid "Centre the chart on the selected files"
msgstr "Центрировать карту на выбранных файлах"

#. fr: Arrêter
msgid "Stop"
msgstr "Стоп"

#. fr: Arrêter l'opération en cours sur la base (import, nettoyage…). Pour un import, les fichiers déjà terminés restent dans la base.
msgid "Stop the current database operation (import, cleaning…). For an import, files already finished stay in the database."
msgstr "Остановить текущую операцию с базой (импорт, очистка…). При импорте уже завершённые файлы остаются в базе."

#. fr: Dossier de la base de bathymétrie
msgid "Bathymetry database folder"
msgstr "Папка базы батиметрии"

#. fr: Palette et seuils de profondeur
msgid "Palette and depth thresholds"
msgstr "Палитра и пороги глубин"

#. fr: (personnalisée)
msgid "(custom)"
msgstr "(своя)"

#. fr: Dégradé continu
msgid "Continuous gradient"
msgstr "Плавный градиент"

#. fr: Paliers
msgid "Steps"
msgstr "Ступени"

#. fr: Automatique
msgid "Automatic"
msgstr "Авто"

#. fr: Seuils répartis entre la profondeur minimale et maximale, couleurs reprises de la palette choisie. Modifier un seuil à la main désactive le mode automatique.
msgid "Thresholds spread between minimum and maximum depth, colours taken from the chosen palette. Editing a threshold by hand turns automatic mode off."
msgstr "Пороги распределены между минимальной и максимальной глубиной, цвета берутся из выбранной палитры. Ручное изменение порога отключает автоматический режим."

#. fr: toutes les données
msgid "all data"
msgstr "все данные"

#. fr: zone affichée
msgid "displayed area"
msgstr "видимая область"

#. fr: Toutes les données : base et couches visibles. Zone affichée : recalculé quand la carte se déplace.
msgid "All data: database and visible layers. Displayed area: recomputed when the chart moves."
msgstr "Все данные: база и видимые слои. Видимая область: пересчёт при перемещении карты."

#. fr: valeurs rondes
msgid "round values"
msgstr "круглые значения"

#. fr: Seuils multiples de 1, 2, 2,5 ou 5 × 10ⁿ (sinon répartis exactement)
msgid "Thresholds are multiples of 1, 2, 2.5 or 5 × 10ⁿ (otherwise spread exactly)"
msgstr "Пороги кратны 1, 2, 2,5 или 5 × 10ⁿ (иначе распределены точно)"

#. fr: seuils
msgid "thresholds"
msgstr "порогов"

#. fr: min imposé
msgid "fixed min"
msgstr "фикс. мин."

#. fr: Premier seuil fixé (ex. 0 m : palette sur la seule bathymétrie, les altitudes gardent une seule couleur)
msgid "First threshold fixed (e.g. 0 m: palette on bathymetry only, land heights keep a single colour)"
msgstr "Первый порог фиксирован (напр. 0 м: палитра только для батиметрии, высоты суши одного цвета)"

#. fr: max imposé
msgid "fixed max"
msgstr "фикс. макс."

#. fr: Dernier seuil fixé : les fonds plus profonds gardent la dernière couleur
msgid "Last threshold fixed: deeper bottoms keep the last colour"
msgstr "Последний порог фиксирован: более глубокое дно сохраняет последний цвет"

#. fr: Seuil (m)
msgid "Threshold (m)"
msgstr "Порог (м)"

#. fr: Couleur (double-clic)
msgid "Colour (double-click)"
msgstr "Цвет (двойной щелчок)"

#. fr: + seuil
msgid "+ threshold"
msgstr "+ порог"

#. fr: − seuil
msgid "− threshold"
msgstr "− порог"

